# SmartCab backend configuration (copy to .env / set in Render env vars)
# NEVER commit real secrets. These defaults are for local dev only.

# Signs auth tokens — set a long random string in production.
SMARTCAB_SECRET_KEY=dev-only-secret-change-me

# Key required by the admin dashboard (frontend /admin page).
SMARTCAB_ADMIN_KEY=smartcab-admin-dev-key

# Key required by POST /api/video/upload-evidence.
SMARTCAB_EVIDENCE_KEY=sk_test_smartcab_vault_9982

# Comma-separated list of allowed frontend origins (dev default: any).
SMARTCAB_CORS_ORIGINS=*

# Enables /api/debug/* endpoints. Keep OFF in production.
SMARTCAB_DEBUG=true

# Optional: real SMS notifications to emergency contacts (Twilio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: Postgres persistence (e.g. Supabase pooler URL).
DATABASE_URL=

# 🤖 AI Safety Agent (POST /api/agent) — Google Gemini, free tier.
# Get a free key in 2 minutes: https://aistudio.google.com/apikey
# If left empty (or a call fails) the agent endpoint automatically falls back
# to the scripted assistant — the app never breaks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional latency tuning (positive seconds; invalid values use these defaults).
# Gemini 3 uses low thinking + temperature 1.0; 2.5 Flash uses thinking_budget=0.
# Greetings/known FAQs use local replies without loading/calling Gemini.
# Overall deadline covers initialization and the complete tool loop. Each model
# request has a shorter timeout (clamped to the overall deadline), with no retries.
SMARTCAB_AGENT_TIMEOUT_SECONDS=60
SMARTCAB_GEMINI_TIMEOUT_SECONDS=20

# Public URL of the rider app — used to build share links the agent sends.
SMARTCAB_FRONTEND_URL=https://smart-cab-security-platform.vercel.app
